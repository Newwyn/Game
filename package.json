{
  "name": "legend-of-capsules",
  "version": "1.0.0",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n server,vite -c yellow,cyan \"node --watch server.js\" \"vite\"",
    "build": "vite build",
    "start": "vite build && node server.js",
    "serve": "node server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "app": "electron .",
    "dist": "vite build && electron-builder --win nsis",
    "dist:dir": "vite build && electron-builder --win dir"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Legend of Capsules - 2.5D real-time action RPG (Three.js + Socket.io)",
  "dependencies": {
    "docx": "^9.8.1",
    "express": "^5.2.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "three": "~0.184.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "concurrently": "^9.2.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "vite": "^6.4.4"
  },
  "build": {
    "appId": "vn.legendofcapsules.game",
    "productName": "Legend of Capsules",
    "electronVersion": "33.4.11",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "server.js",
      "progression.js",
      "game/**",
      "dist/**",
      "src/world/maps.js",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Legend of Capsules"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
